  component Components
  component API_Client

}

rectangle "Backend (FastAPI)\n[[backend_deps.puml]]" {

  package "API Layer (app/api)" {
    component Accounts_API
    component Transactions_API
    component Users_API
    component Ingestion_API
  }

  package "Ingestion Pipeline (app/ingestion)" {
    component Parser
    component Cleaner
    component Validator
    component Ingestion_Service
  }

  package "Database Layer (app/db)" {
    component Session
    component Dependencies
    component Init_DB
  }

  package "Models (app/models)" {
    component Account_Model
    component Transaction_Model
    component User_Model
    component Schemas
  }

}

database DB as "PostgreSQL Database"

User --> Components

Components --> API_Client
API_Client --> Accounts_API
