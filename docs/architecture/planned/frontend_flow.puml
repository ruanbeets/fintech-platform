@startuml

title FinTrack Application Flow

start

:Login Page;

if (Credentials Valid?) then (Yes)

    :Create session;
    :Load Dashboard;

else (No)

    :Show login error;
    stop

endif


partition "Main Application Layout" {

    :Top Bar;
    note right
    Always visible
    - User email / profile
    - Logout button
    end note

    :Sidebar Navigation;
    note right
    - Dashboard
    - Accounts
    - Settings
    end note
}


:Dashboard;

note right
Global Financial Overview
- Net Worth
- Net Cash Flow
- Income vs Expenses
- Balance Trend Chart
- Category Spending Chart
- Recent Transactions
end note


if (User selects Accounts) then (Accounts)

    :Accounts Page;

    :Load all user accounts;

    note right
    Example Accounts:
    - Daily Spending
    - Savings
    - Investment
    end note


    :Account Selector;

    while (User selects account)

        :Update Account Summary;

        note right
        Account Overview
        - Account Balance
        - Balance History Chart
        - Category Spending
        end note


        :Show Transactions Table;

        note right
        Transaction Details
        - Date
        - Description
        - Category
        - Amount
        - Balance
        end note


        :Add / Delete Transaction;

    endwhile

endif


if (User selects Settings) then (Settings)

    :Settings Page;

    partition "User Management" {

        :View user profile;
        :Update email/password;
        :Logout;
    }

    partition "App Preferences" {

        :Theme selection;
        note right
        - Light mode
        - Dark mode
        end note

        :Currency preference;

        :Connected accounts;
        note right
        Bank integrations
        CSV imports
        API connections
        end note
    }

endif


stop

@enduml