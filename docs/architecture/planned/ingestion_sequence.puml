@startuml IngestionSequence

title CSV Transaction Ingestion

actor User
participant Browser
participant "React App"
participant "API Client"
participant "FastAPI Router"
participant "Ingestion Service"
participant Parser
participant Cleaner
participant Validator
participant "Transaction Service"
database PostgreSQL

User -> Browser : Upload CSV
Browser -> "React App" : File
"React App" -> "API Client" : POST /transactions/import

"API Client" -> "FastAPI Router"
"FastAPI Router" -> "Ingestion Service"

"Ingestion Service" -> Parser : parse()
Parser -> Cleaner : clean()
Cleaner -> Validator : validate()

Validator -> "Transaction Service" : valid transactions
"Transaction Service" -> PostgreSQL : insert batch

@enduml