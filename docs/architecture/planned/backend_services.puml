@startuml BackendServices

title Backend Service Architecture

package "API (app/api)" {
    component accounts.py
    component transactions.py
    component users.py
    component ingestion.py
}

package "Services" {
    component TransactionService
    component AccountService
    component UserService
    component IngestionService
}

package "Repositories" {
    component TransactionRepository
    component AccountRepository
    component UserRepository
}

package "Models" {
    component Transaction
    component Account
    component User
}

accounts.py --> AccountService
transactions.py --> TransactionService
users.py --> UserService
ingestion.py --> IngestionService

TransactionService --> TransactionRepository
AccountService --> AccountRepository
UserService --> UserRepository

TransactionRepository --> Transaction
AccountRepository --> Account
UserRepository --> User

@enduml