@startuml
title FinPlan Data Flow Architecture (Lean)

top to bottom direction

package "UI Layer" {
  [Login Page]
  [Dashboard Page]
  [Accounts Page]
  [Transactions Page]
  [Analytics Page]
  [Upload Page]
  [Settings Page]
}

package "Feature Layer (Hooks + API)" {
  [auth]
  [dashboard]
  [accounts]
  [transactions]
  [analytics]
  [upload]
  [settings]
}

package "Core" {
  [apiClient]
  [queryClient]
  [authStore]
}

package "Backend" {
  [REST API]
}

' VERTICAL FLOW

[Login Page] --> [auth]
[Dashboard Page] --> [dashboard]
[Accounts Page] --> [accounts]
[Transactions Page] --> [transactions]
[Analytics Page] --> [analytics]
[Upload Page] --> [upload]
[Settings Page] --> [settings]

[auth] --> [apiClient]
[dashboard] --> [apiClient]
[accounts] --> [apiClient]
[transactions] --> [apiClient]
[analytics] --> [apiClient]
[upload] --> [apiClient]
[settings] --> [apiClient]

[apiClient] --> [REST API]

' STATE LINKS (minimal)
[auth] --> [authStore]
[dashboard] --> [queryClient]
[transactions] --> [queryClient]
[analytics] --> [queryClient]

@enduml