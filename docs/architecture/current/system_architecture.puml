@startuml
title Fintech Platform Architecture (React + FastAPI + PostgreSQL)

actor User

' -----------------------------
' Frontend
' -----------------------------

rectangle "Frontend (React)" {

    component "App Shell" as AppShell
    component "Dashboard Views" as DashboardViews
    component "Account Views" as AccountViews
    component "Charts / Analytics" as Charts
    component "API Client (axios)" as APIClient

}

' -----------------------------
' Backend
' -----------------------------

rectangle "Backend (FastAPI)" {

    package "API Layer" {

        component "Auth API" as AuthAPI
        component "Users API" as UsersAPI
        component "Accounts API" as AccountsAPI
        component "Transactions API" as TransactionsAPI
        component "Analytics API" as AnalyticsAPI
        component "Dashboard API" as DashboardAPI
        component "Budgets API" as BudgetsAPI
        component "Categories API" as CategoriesAPI
        component "Notifications API" as NotificationsAPI
        component "Reports API" as ReportsAPI
        component "Search API" as SearchAPI
        component "Settings API" as SettingsAPI
        component "Ingestion API" as IngestionAPI

    }

    package "Service Layer" {

        component "Users Service" as UsersService
        component "Accounts Service" as AccountsService
        component "Transactions Service" as TransactionsService
        component "Analytics Service" as AnalyticsService
        component "Dashboard Service" as DashboardService
        component "Budgets Service" as BudgetsService
        component "Categories Service" as CategoriesService
        component "Reports Service" as ReportsService
        component "Search Service" as SearchService
        component "Notifications Service" as NotificationsService
        component "Ingestion Service" as IngestionService
    }

    package "Domain Processing" {

        component "Parser" as Parser
        component "Cleaner" as Cleaner
        component "Validator" as Validator

    }

    package "Repository Layer" {

        component "User Repository" as UserRepo
        component "Account Repository" as AccountRepo
        component "Transaction Repository" as TransactionRepo
        component "Budget Repository" as BudgetRepo
        component "Category Repository" as CategoryRepo
        component "Notification Repository" as NotificationRepo
    }

    package "ORM Models" {

        component "User Model" as UserModel
        component "Account Model" as AccountModel
        component "Transaction Model" as TransactionModel
        component "Budget Model" as BudgetModel
        component "Category Model" as CategoryModel
        component "Notification Model" as NotificationModel

    }

}

database "PostgreSQL" as DB

' -----------------------------
' Frontend connections
' -----------------------------

User --> AppShell

AppShell --> DashboardViews
AppShell --> AccountViews
AppShell --> Charts

DashboardViews --> APIClient
AccountViews --> APIClient
Charts --> APIClient

' -----------------------------
' API calls
' -----------------------------

APIClient --> AuthAPI
APIClient --> UsersAPI
APIClient --> AccountsAPI
APIClient --> TransactionsAPI
APIClient --> AnalyticsAPI
APIClient --> DashboardAPI
APIClient --> BudgetsAPI
APIClient --> CategoriesAPI
APIClient --> NotificationsAPI
APIClient --> ReportsAPI
APIClient --> SearchAPI
APIClient --> SettingsAPI
APIClient --> IngestionAPI

' -----------------------------
' API → Services
' -----------------------------

AuthAPI --> UsersService
UsersAPI --> UsersService
AccountsAPI --> AccountsService
TransactionsAPI --> TransactionsService
AnalyticsAPI --> AnalyticsService
DashboardAPI --> DashboardService
BudgetsAPI --> BudgetsService
CategoriesAPI --> CategoriesService
NotificationsAPI --> NotificationsService
ReportsAPI --> ReportsService
SearchAPI --> SearchService
SettingsAPI --> UsersService
IngestionAPI --> IngestionService

' -----------------------------
' Ingestion pipeline
' -----------------------------

IngestionService --> Parser
Parser --> Cleaner
Cleaner --> Validator
Validator --> TransactionRepo

' -----------------------------
' Services → Repositories
' -----------------------------

UsersService --> UserRepo
AccountsService --> AccountRepo
TransactionsService --> TransactionRepo
AnalyticsService --> TransactionRepo
DashboardService --> AccountRepo
DashboardService --> TransactionRepo
BudgetsService --> BudgetRepo
CategoriesService --> CategoryRepo
NotificationsService --> NotificationRepo
ReportsService --> TransactionRepo
SearchService --> TransactionRepo

' -----------------------------
' Repositories → Models
' -----------------------------

UserRepo --> UserModel
AccountRepo --> AccountModel
TransactionRepo --> TransactionModel
BudgetRepo --> BudgetModel
CategoryRepo --> CategoryModel
NotificationRepo --> NotificationModel

' -----------------------------
' Models → Database
' -----------------------------

UserModel --> DB
AccountModel --> DB
TransactionModel --> DB
BudgetModel --> DB
CategoryModel --> DB
NotificationModel --> DB

@enduml