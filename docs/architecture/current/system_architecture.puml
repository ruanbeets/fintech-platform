@startuml FintechSystemArchitecture

title Fintech Platform - Full System Architecture

actor User

' ==================================================
' FRONTEND (REACT)
' ==================================================
rectangle "Frontend (React Application)" {

    ' App Layer
    component AppShell

    package "Pages" {
        component DashboardPage
        component AccountsPage
        component TransactionsPage
        component AnalyticsPage
        component BudgetsPage
        component ReportsPage
        component SettingsPage
    }

    package "UI Components" {
        component DashboardComponents as DC
        component AccountsComponents as AC
        component TransactionsComponents as TC
        component AnalyticsComponents as ANC
        component BudgetsComponents as BC
        component ReportsComponents as RC
        component SettingsComponents as SC
    }

    package "State Management (Context + Hooks)" {
        component AuthContext
        component SettingsContext
        component ThemeContext
        component DataContext
        component DomainHooks as Hooks
    }

    package "Frontend Services" {
        component APIClient as API
        component AuthService
        component AccountsService
        component TransactionsService
        component AnalyticsService
        component BudgetsService
        component ReportsService
        component SettingsService
    }

    package "Utilities" {
        component CurrencyUtils
        component DateUtils
        component ChartUtils
        component ValidationUtils
    }

}

' Frontend Flow
User --> AppShell

AppShell --> DashboardPage
AppShell --> AccountsPage
AppShell --> TransactionsPage
AppShell --> AnalyticsPage
AppShell --> BudgetsPage
AppShell --> ReportsPage
AppShell --> SettingsPage

DashboardPage --> DC
AccountsPage --> AC
TransactionsPage --> TC
AnalyticsPage --> ANC
BudgetsPage --> BC
ReportsPage --> RC
SettingsPage --> SC

DC --> Hooks
AC --> Hooks
TC --> Hooks
Hooks --> DataContext

AppShell --> AuthContext
AuthContext --> SettingsContext
SettingsContext --> ThemeContext
ThemeContext --> DataContext

DataContext --> AccountsService
DataContext --> TransactionsService
DataContext --> AnalyticsService
SettingsContext --> SettingsService
AuthContext --> AuthService

AccountsService --> API
TransactionsService --> API
AuthService --> API

' ==================================================
' BACKEND (FASTAPI)
' ==================================================
rectangle "Backend (FastAPI)" {

    package "API Layer (Routes)" {
        component AuthAPI
        component UsersAPI
        component AccountsAPI
        component TransactionsAPI
        component AnalyticsAPI
        component BudgetsAPI
        component ReportsAPI
        component SettingsAPI
        component NotificationsAPI
        component IngestionAPI
    }

    package "Service Layer (Business Logic)" {
        component AuthServiceBE
        component UserService
        component AccountService
        component TransactionService
        component AnalyticsServiceBE
        component BudgetService
        component ReportService
        component SettingsServiceBE
    }

    package "Data Access Layer" {
        component RepositoryLayer
    }

}

' API Flow
API --> AuthAPI
API --> AccountsAPI
API --> TransactionsAPI
API --> AnalyticsAPI
API --> BudgetsAPI
API --> ReportsAPI
API --> SettingsAPI

' Backend Flow
AuthAPI --> AuthServiceBE
AccountsAPI --> AccountService
TransactionsAPI --> TransactionService
AnalyticsAPI --> AnalyticsServiceBE
BudgetsAPI --> BudgetService
ReportsAPI --> ReportService
SettingsAPI --> SettingsServiceBE

AuthServiceBE --> RepositoryLayer
AccountService --> RepositoryLayer
TransactionService --> RepositoryLayer
AnalyticsServiceBE --> RepositoryLayer
BudgetService --> RepositoryLayer
ReportService --> RepositoryLayer

' ==================================================
' DATABASE
' ==================================================
rectangle "Database Layer" {
    component Database
}

RepositoryLayer --> Database

' ==================================================
' NOTES
' ==================================================
note right of DataContext
Frontend Data Layer:
- Centralized state
- Reduces duplicate API calls
- Acts as cache
end note

note bottom of API
Single HTTP entry point
for frontend → backend communication
end note

note right of RepositoryLayer
Encapsulates DB logic
and ORM interactions
end note

@enduml